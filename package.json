{
  "name": "scms-server",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "db:create": "sequelize db:create",
    "db:drop": "sequelize db:drop",
    "db:seed": "sequelize db:seed:all",
    "db:migrate": "sequelize db:migrate",
    "db:setup": "npm run db:drop && npm run db:create && npm run db:migrate && npm run db:seed",
    "db:reseed": "npm run db:reseed:clean && npm run db:migrate && npm run db:seed:all",
    "db:reseed:clean": "sequelize db:drop && sequelize db:create",
    "db:seed:all": "sequelize db:seed:all",
    "db:seed:undo:all": "sequelize db:seed:undo:all",
    "db:status": "sequelize db:migrate:status",
    "db:migrate:undo": "sequelize db:migrate:undo",
    "db:migrate:undo:all": "sequelize db:migrate:undo:all",
    "start:dev": "nodemon server.js",
    "start:prod": "set NODE_ENV=production && node server.js",
    "test": "jest --detectOpenHandles --forceExit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.3.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "mysql2": "^3.17.0",
    "node-cron": "^4.2.1",
    "node-fetch": "^2.7.0",
    "nodemailer": "^8.0.1",
    "pg": "^8.21.0",
    "pg-hstore": "^2.3.4",
    "rate-limit-redis": "^5.0.0",
    "redis": "^5.12.1",
    "sequelize": "^6.37.7",
    "sequelize-cli": "^6.6.5",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "jest": "^30.3.0",
    "sqlite3": "^6.0.1",
    "supertest": "^7.2.2"
  }
}
